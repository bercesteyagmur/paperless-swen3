{
  "info": {
    "_postman_id": "5c7b7638-a778-4e31-bce9-a6012198e665",
    "name": "Paperless API",
    "description": "Requests for testing all current Paperless file endpoints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8081"
    },
    {
      "key": "userId",
      "value": "1"
    },
    {
      "key": "fileId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Upload file",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "type": "file",
              "src": "api-tests/sample-document.txt"
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/api/files?userId={{userId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "files"
          ],
          "query": [
            {
              "key": "userId",
              "value": "{{userId}}"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "const response = pm.response.json();",
              "pm.collectionVariables.set(\"fileId\", response.id);"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Get all files",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/files"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response is a list\", function () {",
              "    pm.expect(pm.response.json()).to.be.an(\"array\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Get file by ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/files/{{fileId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Correct file is returned\", function () {",
              "    pm.expect(pm.response.json().id).to.eql(Number(pm.collectionVariables.get(\"fileId\")));",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Rename file",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"originalFileName\": \"renamed-document.txt\"\n}"
        },
        "url": "{{baseUrl}}/api/files/{{fileId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"File was renamed\", function () {",
              "    pm.expect(pm.response.json().originalFileName).to.eql(\"renamed-document.txt\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Delete file",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/api/files/{{fileId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 204\", function () {",
              "    pm.response.to.have.status(204);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Get deleted file",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/files/{{fileId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 404\", function () {",
              "    pm.response.to.have.status(404);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    }
  ]
}
